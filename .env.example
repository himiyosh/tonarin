# Copy to .env (git-ignored) and fill in what you need. `npm start` and `npm run pet` read it.
# Never commit .env: it holds keys. See docs/configuration.md for every variable.

# Local proxy
PROXY_API_KEY=change-me-to-a-long-random-string
# PORT=8787

# Local voice (preferred): whisper-server must be on PATH. Audio stays on this computer.
# VOICE_BACKEND=local
# TONARIN_ENABLE_MAIL_MOCK=1
# WHISPER_MODEL=./models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_LANGUAGE=ja

# Legacy Gemini Live voice path. Used only when local whisper.cpp is unavailable.
# The app's settings window keeps the key in the keychain instead.
# GEMINI_API_KEY=
# GEMINI_VOICE=Aoede
# LIVE_LANGUAGE=ja
# LIVE_SILENCE_MS=700

# GitHub Copilot (deep dives). Sign in once with the Copilot CLI, or:
# COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5.4-mini
COPILOT_REASONING_EFFORT=none

# Diagnostics: request shapes, event types and token counts only, never content
# DEBUG_REQUESTS=1
